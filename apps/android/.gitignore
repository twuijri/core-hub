# Gradle and Android Studio
.gradle/
build/
local.properties
.idea/
*.iml
.kotlin/
captures/
# Firebase configuration: written from a CI secret for signed builds, never committed.
google-services.json
# Release keystores are CI secrets.
*.jks
*.keystore

# The repository's root .gitignore drops every `data/` folder (a hub's local data); the app's
# `data` source packages are code, not data.
!app/src/main/java/hub/core/android/data/
!app/src/test/java/hub/core/android/data/
