{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/i18n/*.json"
  ]
}
