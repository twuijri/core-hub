{
  "name": "@corehub/desktop",
  "productName": "Core Hub",
  "version": "1.1.2",
  "private": true,
  "description": "Core Hub desktop app: the web client in an Electron shell, in remote or local mode (ADR 0009, ADR 0020).",
  "homepage": "https://github.com/twuijri/core-hub",
  "author": "twuijri <twuijri@users.noreply.github.com>",
  "license": "Apache-2.0",
  "desktopName": "corehub.desktop",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-hub.mjs",
    "typecheck": "pnpm --filter @corehub/contracts build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "pnpm --filter @corehub/contracts build && vitest run",
    "electron:install": "node scripts/electron-install.mjs",
    "start": "node scripts/build.mjs && electron .",
    "test:smoke": "playwright test -c tests/smoke/playwright.config.ts",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@corehub/contracts": "workspace:*",
    "@corehub/server": "workspace:*",
    "@corehub/web": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "^0.28.2",
    "smol-toml": "^1.9.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
