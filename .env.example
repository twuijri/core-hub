# Copy to .env for `docker compose up`. Never commit .env.
# Nothing here is required: on a fresh install the hub prints a one-time setup token
# (`docker compose logs hub`) and you create the owner account in the browser (ADR 0011).
HUB_PORT=8080
# Unattended installs only: set this before the first boot and the hub creates the owner
# `admin` with this password instead of asking. It is read once and ignored afterwards.
# HUB_ADMIN_PASSWORD=
# DATABASE_URL=postgres://hub:password@db:5432/hub
