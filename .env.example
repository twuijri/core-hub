# Copy to .env for `docker compose up`. Never commit .env.
# Nothing here is required: on a fresh install open the hub in a browser within the hour and
# create the owner account there (ADR 0019). After the hour it asks for the setup token the
# hub prints (`docker compose logs hub`), or restart the hub to open setup again.
HUB_PORT=8080
# Unattended installs only: set this before the first boot and the hub creates the owner
# `admin` with this password instead of asking. It is read once and ignored afterwards.
# HUB_ADMIN_PASSWORD=
# DATABASE_URL=postgres://hub:password@db:5432/hub
# First-run setup open without the token for this many minutes after boot; 0 = token only.
# COREHUB_SETUP_OPEN_MINUTES=60
# Someone else created the owner first? Set 1, restart, create the owner again, then REMOVE it.
# COREHUB_RESET_OWNER=1
