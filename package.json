{
  "name": "majlis",
  "version": "0.0.0",
  "private": true,
  "description": "Majlis — a self-hosted hub for AI agents. Server first; every client renders one contract.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "contracts:lint": "pnpm --filter @majlis/contracts lint",
    "contracts:generate": "pnpm --filter @majlis/contracts generate",
    "contracts:generate:ts": "pnpm --filter @majlis/contracts generate:ts",
    "contracts:check-clients": "node packages/contracts/scripts/check-clients.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "contract:test": "pnpm --filter @majlis/server contract:test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "db:generate": "pnpm --filter @majlis/server db:generate",
    "db:migrate": "pnpm --filter @majlis/server db:migrate",
    "i18n:check": "node scripts/i18n-check.mjs",
    "nav:check": "node scripts/navigation-check.mjs",
    "change-record:check": "node scripts/check-change-record.mjs",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @majlis/server dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
