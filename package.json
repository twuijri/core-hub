{
  "name": "corehub",
  "version": "1.1.2",
  "private": true,
  "description": "Core Hub — a self-hosted hub for AI agents. Server first; every client renders one contract.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "contracts:lint": "pnpm --filter @corehub/contracts lint",
    "contracts:generate": "pnpm --filter @corehub/contracts generate",
    "contracts:generate:ts": "pnpm --filter @corehub/contracts generate:ts",
    "contracts:check-clients": "node packages/contracts/scripts/check-clients.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "contract:test": "pnpm --filter @corehub/server contract:test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "db:generate": "pnpm --filter @corehub/server db:generate",
    "db:migrate": "pnpm --filter @corehub/server db:migrate",
    "i18n:check": "node scripts/i18n-check.mjs",
    "nav:check": "node scripts/navigation-check.mjs",
    "change-record:check": "node scripts/check-change-record.mjs",
    "version:check": "node scripts/version-check.mjs",
    "scripts:test": "node --test \"apps/ios/scripts/*.test.mjs\"",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "dev": "pnpm --filter @corehub/server dev",
    "web:dev": "pnpm --filter @corehub/web dev",
    "web:e2e": "pnpm --filter @corehub/web test:e2e",
    "tokens:build": "pnpm --filter @corehub/ui-tokens build",
    "icons:build": "node scripts/icons/build-icons.mjs",
    "icons:lucide": "node scripts/icons/lucide-web.mjs && node scripts/icons/lucide-mobile.mjs",
    "icons:agents": "node scripts/icons/agent-marks-mobile.mjs",
    "graph": "node scripts/graph.mjs",
    "graph:check": "node scripts/graph-check.mjs",
    "image:sealed-check": "node scripts/image-sealed-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lucide-static": "1.48.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
