{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/twuijri/core-hub/blob/main/packages/contracts/events/tasks/worktree.updated.schema.json",
  "title": "/rt/tasks · worktree.updated",
  "description": "Emitted by: tasks module (worktree jobs, git status polling while a run is active).",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "worktree.updated"
    },
    "namespace": {
      "const": "/rt/tasks"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["task_id", "worktree"],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/Ulid"
        },
        "worktree": {
          "oneOf": [
            {
              "$ref": "#/$defs/Worktree"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "worktree.updated",
      "namespace": "/rt/tasks",
      "profile": "work",
      "ts": "2026-09-21T10:15:04Z",
      "seq": 8812,
      "payload": {
        "task_id": "01J8QK3ZR2W7M5N4P6T8V9X0TK",
        "worktree": {
          "path": "/home/agent/worktrees/corehub/task-01J8QK3ZR2W7M5N4P6T8V9X0TK",
          "branch": "task/settings-page",
          "base_branch": "main",
          "status": "ready",
          "ahead": 3,
          "behind": 0,
          "changed_files": 7,
          "error": null,
          "updated_at": "2026-09-21T10:00:00Z"
        }
      }
    }
  ],
  "$defs": {
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    },
    "Worktree": {
      "type": "object",
      "required": [
        "path",
        "branch",
        "base_branch",
        "status",
        "ahead",
        "behind",
        "changed_files",
        "error",
        "updated_at"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "base_branch": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["creating", "ready", "dirty", "merged", "removed", "error"]
        },
        "ahead": {
          "type": "integer"
        },
        "behind": {
          "type": "integer"
        },
        "changed_files": {
          "type": "integer"
        },
        "error": {
          "type": ["string", "null"]
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    }
  }
}
