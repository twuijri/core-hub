{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corehub.dev/contracts/events/devices/device.unlinked.schema.json",
  "title": "/rt/devices · device.unlinked",
  "description": "User-level. Emitted by: devices/auth modules (unlink, token revoked, user deleted).",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "device.unlinked"
    },
    "namespace": {
      "const": "/rt/devices"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["device_id"],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/Ulid"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "device.unlinked",
      "namespace": "/rt/devices",
      "profile": null,
      "ts": "2026-09-21T10:15:04Z",
      "seq": 8812,
      "payload": {
        "device_id": "01J8QK3ZR2W7M5N4P6T8V9X0DV"
      }
    }
  ],
  "$defs": {
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    }
  }
}
