{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majlis.dev/contracts/events/schedules/workflow_run.failed.schema.json",
  "title": "/rt/schedules · workflow_run.failed",
  "description": "Run-level state with all steps. Subscribers of the workflow; profile-wide as `job.*` on /rt/jobs. Emitted by: schedules module (workflow engine).",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "workflow_run.failed"
    },
    "namespace": {
      "const": "/rt/schedules"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["workflow_run"],
      "properties": {
        "workflow_run": {
          "$ref": "#/$defs/WorkflowRun"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "workflow_run.failed",
      "namespace": "/rt/schedules",
      "profile": "work",
      "ts": "2026-09-21T10:15:04Z",
      "seq": 8812,
      "payload": {
        "workflow_run": {
          "id": "01J8QK3ZR2W7M5N4P6T8V9X0WR",
          "profile": "work",
          "owner_id": "01J8QK3ZR2W7M5N4P6T8V9X0HM",
          "created_at": "2026-09-21T09:00:00Z",
          "updated_at": "2026-09-21T09:05:00Z",
          "workflow_id": "01J8QK3ZR2W7M5N4P6T8V9X0WF",
          "job_id": "01J8QK3ZR2W7M5N4P6T8V9X0JY",
          "status": "failed",
          "trigger": {
            "kind": "user",
            "id": "01J8QK3ZR2W7M5N4P6T8V9X0HM"
          },
          "input": null,
          "steps": [
            {
              "node_id": "review",
              "attempt": 1,
              "status": "succeeded",
              "session_id": "01J8QK3ZR2W7M5N4P6T8V9X0YG",
              "run_id": "01J8QK3ZR2W7M5N4P6T8V9X0RV",
              "approval_id": null,
              "error": null,
              "started_at": "2026-09-21T09:00:01Z",
              "finished_at": "2026-09-21T09:04:00Z"
            }
          ],
          "error": null,
          "started_at": "2026-09-21T09:00:00Z",
          "finished_at": null
        }
      }
    }
  ],
  "$defs": {
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "RunTrigger": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "room", "task", "schedule", "workflow", "handoff", "api"]
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The user, seat, task, schedule, workflow run or chain that caused the run."
        }
      }
    },
    "Scoped": {
      "type": "object",
      "description": "Fields every row a client can show carries (ARCHITECTURE §Data ownership).",
      "required": ["id", "profile", "owner_id", "created_at", "updated_at"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Ulid"
        },
        "profile": {
          "$ref": "#/$defs/ProfileSlug"
        },
        "owner_id": {
          "$ref": "#/$defs/Ulid"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    },
    "WorkflowRun": {
      "allOf": [
        {
          "$ref": "#/$defs/Scoped"
        },
        {
          "type": "object",
          "required": [
            "workflow_id",
            "job_id",
            "status",
            "trigger",
            "input",
            "steps",
            "error",
            "started_at",
            "finished_at"
          ],
          "properties": {
            "workflow_id": {
              "$ref": "#/$defs/Ulid"
            },
            "job_id": {
              "$ref": "#/$defs/Ulid"
            },
            "status": {
              "type": "string",
              "enum": ["queued", "running", "waiting", "succeeded", "failed", "cancelled"]
            },
            "trigger": {
              "$ref": "#/$defs/RunTrigger"
            },
            "input": {
              "type": ["string", "null"]
            },
            "steps": {
              "type": "array",
              "description": "Latest attempt per node, in execution order.",
              "items": {
                "$ref": "#/$defs/WorkflowStep"
              }
            },
            "error": {
              "type": ["string", "null"]
            },
            "started_at": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "finished_at": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "WorkflowStep": {
      "type": "object",
      "required": [
        "node_id",
        "attempt",
        "status",
        "session_id",
        "run_id",
        "approval_id",
        "error",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/WorkflowStepStatus"
        },
        "session_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The session where the step's agent worked; its output is that session's last assistant message."
        },
        "run_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": ["string", "null"]
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "WorkflowStepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "running",
        "waiting_approval",
        "succeeded",
        "failed",
        "skipped",
        "cancelled",
        "rejected"
      ]
    }
  }
}
