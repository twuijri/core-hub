{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/twuijri/core-hub/blob/main/packages/contracts/events/sessions/subagent.updated.schema.json",
  "title": "/rt/sessions · subagent.updated",
  "description": "A running subagent called a tool or stopped taking guidance; `subagent` is its whole state. Profile-wide. Emitted by: sessions module from the agent's delegation reports (contract decision §56).",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "subagent.updated"
    },
    "namespace": {
      "const": "/rt/sessions"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["subagent"],
      "properties": {
        "subagent": {
          "$ref": "#/$defs/Subagent"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "subagent.updated",
      "namespace": "/rt/sessions",
      "profile": "work",
      "ts": "2026-09-21T10:15:05Z",
      "seq": 8813,
      "payload": {
        "subagent": {
          "id": "sa-2-7f3c",
          "session_id": "01J8QK3ZR2W7M5N4P6T8V9X0YA",
          "run_id": "01J8QK3ZR2W7M5N4P6T8V9X0RN",
          "parent_id": null,
          "depth": 0,
          "goal": "راجع ملفات الاختبارات واذكر ما ينقصها",
          "model": "claude-sonnet-4.6",
          "status": "running",
          "started_at": "2026-09-21T10:15:05Z",
          "finished_at": null,
          "tool_count": 1,
          "last_tool": "read_file",
          "accepting_steer": true,
          "summary": null,
          "tools": [
            {
              "name": "read_file",
              "preview": "tests/unit/status.test.ts",
              "at": "2026-09-21T10:15:09Z"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "Subagent": {
      "type": "object",
      "description": "One delegated agent of a conversation. `id` is the agent's own (not a ULID). A nested\nsubagent names the one that started it in `parent_id`; `depth` is 0 for one the\nconversation's agent started itself.\n",
      "required": [
        "id",
        "session_id",
        "run_id",
        "parent_id",
        "depth",
        "goal",
        "model",
        "status",
        "started_at",
        "finished_at",
        "tool_count",
        "last_tool",
        "accepting_steer",
        "summary",
        "tools"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 200
        },
        "session_id": {
          "$ref": "#/$defs/Ulid"
        },
        "run_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The run that was going when it started; `null` when none was."
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "goal": {
          "type": "string",
          "description": "What it was asked to do, in the agent's words."
        },
        "model": {
          "type": ["string", "null"]
        },
        "status": {
          "$ref": "#/$defs/SubagentStatus"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "finished_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Tools it called so far; `null` when the agent does not say (`observe`)."
        },
        "last_tool": {
          "type": ["string", "null"]
        },
        "accepting_steer": {
          "type": "boolean",
          "description": "A note sent now would reach it (`sessions.steerSubagent`)."
        },
        "summary": {
          "type": ["string", "null"],
          "description": "Its last words when it finished, or why it failed."
        },
        "tools": {
          "type": "array",
          "maxItems": 50,
          "description": "Its most recent tool calls, oldest first (at most 50).",
          "items": {
            "$ref": "#/$defs/SubagentTool"
          }
        }
      }
    },
    "SubagentStatus": {
      "type": "string",
      "enum": ["running", "completed", "failed", "interrupted"]
    },
    "SubagentTool": {
      "type": "object",
      "required": ["name", "preview", "at"],
      "properties": {
        "name": {
          "type": "string"
        },
        "preview": {
          "type": ["string", "null"],
          "description": "The agent's one-line summary of the call, when it gave one."
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    }
  }
}
