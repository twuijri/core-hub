{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/twuijri/core-hub/blob/main/packages/contracts/events/sessions/channel_conversation.updated.schema.json",
  "title": "/rt/sessions · channel_conversation.updated",
  "description": "A channel conversation changed (contract decision §153): a turn began or ended in it on Hermes's messaging gateway (`turn_started`, `turn_ended` — a message on the channel, or one written from the hub), or a message written from the hub moved on (`outgoing`, with that message). Profile-wide. Emitted by: sessions module, from what the hub's bridge in Hermes's gateway reports. A client refetches the conversation (`sessions.listChannelMessages`) and the list (`sessions.listChannelConversations`) instead of waiting for its next poll; the reply is in the transcript when `turn_ended` arrives.",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "channel_conversation.updated"
    },
    "namespace": {
      "const": "/rt/sessions"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["conversation_id", "channel", "reason", "outgoing"],
      "properties": {
        "conversation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "description": "Hermes's session id — the `ChannelConversation.id`."
        },
        "channel": {
          "type": "string",
          "description": "The platform (`telegram`, `whatsapp`, …), as `ChannelConversation.channel`."
        },
        "reason": {
          "type": "string",
          "enum": ["turn_started", "turn_ended", "outgoing"],
          "description": "What changed."
        },
        "outgoing": {
          "oneOf": [
            {
              "$ref": "#/$defs/ChannelOutgoing"
            },
            {
              "type": "null"
            }
          ],
          "description": "With `outgoing`, the hub's message as it now stands; `null` otherwise."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "channel_conversation.updated",
      "namespace": "/rt/sessions",
      "profile": "work",
      "ts": "2026-10-08T09:15:04Z",
      "seq": 8812,
      "payload": {
        "conversation_id": "20260925_091500_3f9a1c2b",
        "channel": "telegram",
        "reason": "outgoing",
        "outgoing": {
          "id": "01J8QK3ZR2W7M5N4P6T8V9X0QG",
          "conversation_id": "20260925_091500_3f9a1c2b",
          "client_message_id": null,
          "text": "أرسل له موعد التسليم الجديد، يوم الأحد.",
          "author_name": "طارق",
          "status": "answering",
          "error": null,
          "message_id": "57",
          "session_id": "20260925_091500_3f9a1c2b",
          "created_at": "2026-10-08T09:15:00Z",
          "updated_at": "2026-10-08T09:15:04Z"
        }
      }
    }
  ],
  "$defs": {
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    },
    "ChannelSendFailure": {
      "type": "object",
      "required": ["reason", "message"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["bridge_no_answer", "not_accepted", "not_picked_up"]
        },
        "message": {
          "type": ["string", "null"]
        }
      }
    },
    "ChannelOutgoing": {
      "type": "object",
      "description": "Something a person wrote into a channel conversation from the hub, as the hub follows it (contract decision §153).",
      "required": [
        "id",
        "conversation_id",
        "client_message_id",
        "text",
        "author_name",
        "status",
        "error",
        "message_id",
        "session_id",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Ulid"
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "client_message_id": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "text": {
          "type": "string"
        },
        "author_name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["posted", "delivered", "answering", "answered", "failed"]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/ChannelSendFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "message_id": {
          "type": ["string", "null"]
        },
        "session_id": {
          "type": ["string", "null"]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    }
  }
}
