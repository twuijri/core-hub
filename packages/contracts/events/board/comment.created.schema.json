{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majlis.dev/contracts/events/board/comment.created.schema.json",
  "title": "/rt/board · comment.created",
  "description": "Emitted by: board module (people and agents).",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "comment.created"
    },
    "namespace": {
      "const": "/rt/board"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["comment"],
      "properties": {
        "comment": {
          "$ref": "#/$defs/Comment"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "comment.created",
      "namespace": "/rt/board",
      "profile": "work",
      "ts": "2026-09-21T10:15:04Z",
      "seq": 8812,
      "payload": {
        "comment": {
          "id": "01J8QK3ZR2W7M5N4P6T8V9X0CM",
          "task_id": "01J8QK3ZR2W7M5N4P6T8V9X0TK",
          "author": {
            "kind": "user",
            "id": "01J8QK3ZR2W7M5N4P6T8V9X0HM",
            "name": "طارق",
            "avatar": {
              "kind": "generated",
              "url": null,
              "seed": "tariq"
            }
          },
          "content": "التزم بألوان خريطة التصميم.",
          "created_at": "2026-09-21T09:40:00Z"
        }
      }
    }
  ],
  "$defs": {
    "Author": {
      "type": "object",
      "description": "Who wrote a message. Agents in rooms are identified by their seat, see `Message.seat_id`.",
      "required": ["kind", "id", "name", "avatar"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "agent", "system"]
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "avatar": {
          "oneOf": [
            {
              "$ref": "#/$defs/Avatar"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Avatar": {
      "type": "object",
      "description": "A picture for a person, agent or profile. `generated` avatars are drawn by the client from `seed`.",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["image", "generated"]
        },
        "url": {
          "type": ["string", "null"],
          "description": "Fetchable with the bearer token when `kind = image`."
        },
        "seed": {
          "type": ["string", "null"],
          "description": "Deterministic seed when `kind = generated`."
        }
      },
      "examples": [
        {
          "kind": "generated",
          "url": null,
          "seed": "work"
        }
      ]
    },
    "Comment": {
      "type": "object",
      "required": ["id", "task_id", "author", "content", "created_at"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Ulid"
        },
        "task_id": {
          "$ref": "#/$defs/Ulid"
        },
        "author": {
          "$ref": "#/$defs/Author"
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    }
  }
}
