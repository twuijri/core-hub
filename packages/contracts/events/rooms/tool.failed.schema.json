{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corehub.dev/contracts/events/rooms/tool.failed.schema.json",
  "title": "/rt/rooms · tool.failed",
  "description": "Same payload as `/rt/sessions`; `message.room_id` / `run.room_id` and `seat_id` are set. Members of the room receive it without subscribing to seat sessions. Emitted by: sessions module, re-emitted to the room.",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "tool.failed"
    },
    "namespace": {
      "const": "/rt/rooms"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["session_id", "message_id", "run_id", "tool_call"],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/Ulid"
        },
        "message_id": {
          "$ref": "#/$defs/Ulid"
        },
        "run_id": {
          "$ref": "#/$defs/Ulid"
        },
        "tool_call": {
          "$ref": "#/$defs/ToolCall"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "tool.failed",
      "namespace": "/rt/rooms",
      "profile": "work",
      "ts": "2026-09-21T10:15:04Z",
      "seq": 8812,
      "payload": {
        "session_id": "01J8QK3ZR2W7M5N4P6T8V9X0YA",
        "message_id": "01J8QK3ZR2W7M5N4P6T8V9X0MB",
        "run_id": "01J8QK3ZR2W7M5N4P6T8V9X0RN",
        "tool_call": {
          "id": "01J8QK3ZR2W7M5N4P6T8V9X0TC",
          "name": "shell",
          "status": "failed",
          "preview": "pnpm test --filter server",
          "arguments": {
            "command": "pnpm test --filter server"
          },
          "output": "42 passed",
          "output_truncated": false,
          "duration_ms": 35000,
          "subagent_id": null,
          "started_at": "2026-09-21T10:15:04Z",
          "finished_at": "2026-09-21T10:15:39Z"
        }
      }
    }
  ],
  "$defs": {
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "ToolCall": {
      "type": "object",
      "description": "One tool invocation inside an assistant message. Tool output lives here, not in a separate message.",
      "required": [
        "id",
        "name",
        "status",
        "preview",
        "arguments",
        "output",
        "output_truncated",
        "duration_ms",
        "subagent_id",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Ulid"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolCallStatus"
        },
        "preview": {
          "type": ["string", "null"],
          "description": "One-line summary for the tool card (a command, a path)."
        },
        "arguments": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "output": {
          "type": ["string", "null"],
          "description": "Truncated to 16 KB; `output_truncated` says so."
        },
        "output_truncated": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": ["integer", "null"]
        },
        "subagent_id": {
          "type": ["string", "null"],
          "description": "Set when the call was made by a delegated subagent."
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ToolCallStatus": {
      "type": "string",
      "enum": ["running", "succeeded", "failed", "interrupted", "awaiting_approval"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    }
  }
}
