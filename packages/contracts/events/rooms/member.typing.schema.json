{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majlis.dev/contracts/events/rooms/member.typing.schema.json",
  "title": "/rt/rooms · member.typing",
  "description": "A person started or stopped typing. Not persisted. Emitted by: rooms module from the `typing` command.",
  "type": "object",
  "required": ["event", "namespace", "profile", "ts", "seq", "payload"],
  "properties": {
    "event": {
      "const": "member.typing"
    },
    "namespace": {
      "const": "/rt/rooms"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProfileSlug"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": ["room_id", "member_id", "name", "typing"],
      "properties": {
        "room_id": {
          "$ref": "#/$defs/Ulid"
        },
        "member_id": {
          "$ref": "#/$defs/Ulid"
        },
        "name": {
          "type": "string"
        },
        "typing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": "member.typing",
      "namespace": "/rt/rooms",
      "profile": "work",
      "ts": "2026-09-21T10:15:04Z",
      "seq": 8812,
      "payload": {
        "room_id": "01J8QK3ZR2W7M5N4P6T8V9X0RM",
        "member_id": "01J8QK3ZR2W7M5N4P6T8V9X0MM",
        "name": "سارة",
        "typing": true
      }
    }
  ],
  "$defs": {
    "ProfileSlug": {
      "type": "string",
      "description": "Workspace (profile) slug — lowercase letters, digits and dashes.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "examples": ["work"]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with `Z`.",
      "examples": ["2026-09-21T10:15:00Z"]
    },
    "Ulid": {
      "type": "string",
      "description": "26-character Crockford base32 ULID, sortable by creation time.",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26,
      "examples": ["01J8QK3ZR2W7M5N4P6T8V9X0YA"]
    }
  }
}
