{
  "name": "@majlis/server",
  "version": "0.0.0",
  "private": true,
  "description": "Majlis server: Fastify + Socket.IO + Drizzle. Owns the truth about agents, sessions, rooms, tasks and schedules.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "pnpm --filter @majlis/contracts build && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @majlis/contracts build && tsc --noEmit -p tsconfig.json",
    "build": "pnpm --filter @majlis/contracts build && tsc -p tsconfig.json",
    "test": "pnpm --filter @majlis/contracts build && vitest run --project unit",
    "contract:test": "pnpm --filter @majlis/contracts build && vitest run --project contract",
    "db:generate": "node scripts/db.mjs generate",
    "db:migrate": "node scripts/db.mjs migrate"
  },
  "dependencies": {
    "@majlis/contracts": "workspace:*",
    "argon2": "0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "jose": "6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
