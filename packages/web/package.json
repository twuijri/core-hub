{
  "name": "@corehub/web",
  "version": "0.0.0",
  "private": true,
  "description": "Core Hub web client: Vite + React, generated from the contract, implementing docs/clients/NAVIGATION.md.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @corehub/contracts build && pnpm --filter @corehub/ui-tokens build && tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "pnpm --filter @corehub/contracts build && pnpm --filter @corehub/ui-tokens build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm --filter @corehub/contracts build && pnpm --filter @corehub/ui-tokens build && vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@corehub/contracts": "workspace:*",
    "@corehub/ui-tokens": "workspace:*",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fflate": "^0.8.3",
    "lowlight": "^3.3.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
