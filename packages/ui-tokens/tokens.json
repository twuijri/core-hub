  "glass": {
    "$comment": "One intensity scale for every floating chrome surface (sidebar, composer, top bar, popovers). 0 = solid, 3 = full. alpha is the tint's opacity over whatever scrolls behind it; the contrast test composites the tint over `bg` at each alpha.",
    "default": 2,
    "levels": {
      "0": {
        "blur": "0px",
        "alpha": 1,
        "borderAlpha": 1,
        "saturate": 1,
        "shadow": "none"
      },
      "1": {
        "blur": "10px",
        "alpha": 0.9,
        "borderAlpha": 0.8,
        "saturate": 1.1,
        "shadow": "0 1px 2px rgb(0 0 0 / 0.06)"
      },
      "2": {
        "blur": "18px",
        "alpha": 0.78,
        "borderAlpha": 0.6,
        "saturate": 1.35,
        "shadow": "0 8px 30px rgb(0 0 0 / 0.10)"
      },
      "3": {
        "blur": "30px",
        "alpha": 0.62,
        "borderAlpha": 0.45,
        "saturate": 1.6,
        "shadow": "0 12px 40px rgb(0 0 0 / 0.14)"
      }
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "full": "9999px"
  },
  "shadow": {
    "$comment": "One elevation scale. `sm` is the lift of a selected segment, `md` a popover, `lg` a dialog.",
    "sm": "0 1px 2px rgb(0 0 0 / 0.07), 0 1px 1px rgb(0 0 0 / 0.04)",
    "md": "0 4px 12px rgb(0 0 0 / 0.10), 0 1px 3px rgb(0 0 0 / 0.06)",
    "lg": "0 12px 32px rgb(0 0 0 / 0.16), 0 2px 8px rgb(0 0 0 / 0.08)"
  },
  "control": {
    "$comment": "The segmented control (src/ui/Segmented.tsx): one track, three sizes. Item radius is the track radius minus its padding, so the corners stay concentric.",
    "track-pad": "0.1875rem",
    "track-radius": "0.75rem",
    "item-radius": "0.5625rem",
    "gap": "0.125rem",
    "height-sm": "1.75rem",
    "height-md": "2.125rem",
    "height-lg": "2.5rem",
    "pad-sm": "0.5rem",
    "pad-md": "0.75rem",
    "pad-lg": "1rem",
    "font-sm": "var(--mj-font-size-xs)",
    "font-md": "var(--mj-font-size-sm)",
    "font-lg": "var(--mj-font-size-md)"
  },
  "font": {
    "sans": "\"Segoe UI\", \"Noto Sans Arabic\", \"Noto Sans\", system-ui, -apple-system, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "size-xs": "0.75rem",
    "size-sm": "0.875rem",
    "size-md": "1rem",
    "size-lg": "1.125rem",
    "size-xl": "1.375rem",
    "size-2xl": "1.75rem",
    "leading-tight": "1.25",
    "leading-normal": "1.55",
    "leading-relaxed": "1.75"
  },
  "layout": {
    "reading-max": "48rem",
    "sidebar-width": "18rem",
    "sidebar-min": "14rem",
    "settings-nav": "14rem",
    "pane-min": "18rem",
    "pane-default": "34rem",
    "topbar-height": "3.25rem",
    "composer-max": "48rem",
