# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# generated clients (regenerated by `pnpm contracts:generate`)
packages/contracts/generated/*
!packages/contracts/generated/.gitkeep

# local data and secrets
data/
.env
.env.*
!.env.example
*.sqlite
*.sqlite-journal
*.db

# tool caches and logs
.eslintcache
coverage/
*.log
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json

# web client
packages/web/playwright-report/
packages/web/test-results/
packages/ui-tokens/dist/

# web e2e: the throwaway data directory of the first-run setup hub
packages/web/e2e/.setup-data/

# Graphify (docs/harness/knowledge-graph.md): the map is committed; its cache and the
# per-machine manifest (file times) are not — a rebuild takes seconds.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
